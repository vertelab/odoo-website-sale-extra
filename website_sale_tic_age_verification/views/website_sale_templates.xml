<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_age_verification" inherit_id="website_sale.payment" name="Age Verification on Payment">
        <xpath expr="//div[@id='payment_method']" position="before">
            <t t-set="partner" t-value="website_sale_order.partner_id"/>
            <t t-set="is_public_user" t-value="request.env.user._is_public()"/>
            
            <div id="age_verification" class="my-3" t-if="is_public_user or partner.tic_identity_status != 'verified'">
                <div class="alert alert-warning border-warning d-flex align-items-center shadow-sm p-3">
                    <div class="me-3">
                        <i class="fa fa-exclamation-triangle fa-2x text-warning"/>
                    </div>
                    <div>
                        <h6 class="alert-heading fw-bolder mb-1">Age Verification Required</h6>
                        <p class="small mb-2">To comply with legal requirements, you must verify your age before you can complete your purchase.</p>

                        <a role="button" class="btn btn-primary btn-sm" t-attf-href="/tic/verify-identity?redirect=#{request.httprequest.full_path}">
                            <i class="fa fa-id-card me-2"/>Verify Age
                        </a>

                        <div t-if="request.params.get('error')" class="alert alert-danger small mt-2 mb-0 p-2">
                            <i class="fa fa-exclamation-circle me-1"/>Verification failed. Please try again.
                        </div>
                    </div>
                </div>
            </div>
        </xpath>

    </template>
</odoo>
